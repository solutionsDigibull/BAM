    {
      "id": "testgen-01",
      "description": "login with a one-time code, max_iterations 1",
      "synthetic": true,
      "overrides": {
        "max_iterations": 1,
        "required_inputs": [
          "mobile_number",
          "otp_payload",
          "device_fingerprint"
        ],
        "fresh_state_parameters": [
          "failed_login_attempts",
          "active_devices",
          "user_status"
        ],
        "tables": [
          "investor_profiles",
          "auth_event_audit_handoff"
        ],
        "success_gate": "otp_match == True AND policy_violation == False",
        "no_op_condition": "user_status is 'LOCKED'",
        "escalation_condition": "failed_login_attempts >= max_iterations"
      }
