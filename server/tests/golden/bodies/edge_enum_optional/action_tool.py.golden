def verify_otp(
    mobile_number: str,
    attempt: Literal[1, 2, 3],
    channel: Literal["sms", "email", "wh'at"] | None = None,
    tags: list[str] | None = None,
    strict: bool | None = None,
) -> dict[str, Any]:
    """Verify the \"OTP\" sent to mobile_number over channel; 'quotes' and C:\\paths are
