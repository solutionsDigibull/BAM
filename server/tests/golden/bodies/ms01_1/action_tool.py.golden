"""Action tool for Sub-Skill MS01.1_Investor_Auth_Manager.

Generated by SBAM from template fastmcp-loopy 1.0.0.
Only the regions between the LLM_BODY markers are written by the LLM.
"""

from __future__ import annotations

from typing import Any

from . import state, state_handoff

TOOL_NAME = "auth_mcp_session_otp_evaluator"

# >>> LLM_BODY:helpers
def _within_device_limit(current: state.FreshState) -> bool:
    limit = int(state.PARAMETERS["max_device_limit"])
    return int(current.active_devices or 0) <= limit
# <<< LLM_BODY:helpers


def auth_mcp_session_otp_evaluator(
    mobile_number: str,
    otp_payload: str,
    device_fingerprint: str,
) -> dict[str, Any]:
    """Compare provided OTP against Auth_MCP memory and calculate device fingerprint limits.

    Must call state_handoff.append(...) with: iteration_pass, device_fingerprint, otp_match,
    access_scope.
    """
    current: state.FreshState = state.read(mobile_number)
    # >>> LLM_BODY:action
    otp_match = current.user_status == "active" and bool(otp_payload)
    allowed = otp_match and _within_device_limit(current)
    state_handoff.append(
        iteration_pass=int(current.failed_login_attempts or 0) + 1,
        device_fingerprint=device_fingerprint,
        otp_match=otp_match,
        access_scope="investor" if allowed else "none",
    )
    return {
        "auth_status": "AUTHENTICATED" if allowed else "DENIED",
        "user_role": "investor" if allowed else None,
        "jwt_token": None,
        "state_handoff_id": None,
    }
    # <<< LLM_BODY:action
