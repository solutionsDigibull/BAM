"""

from __future__ import annotations

from typing import Any

from . import state

TOOL_NAME = "rbac_mcp_policy_limit_validator"
GATE_OUTPUTS: tuple[str, ...] = (
    "otp_match",
    "policy_violation",
)

# >>> LLM_BODY:helpers
def _within_device_limit(current: state.FreshState) -> bool:
    limit = int(state.PARAMETERS["max_device_limit"])
    return int(current.active_devices or 0) <= limit
# <<< LLM_BODY:helpers


def rbac_mcp_policy_limit_validator(
    mobile_number: str,
    otp_payload: str,
    device_fingerprint: str,
) -> dict[str, Any]:
    """Programmatically evaluate if otp_match == True AND active_devices <= max_device_limit.

    Must return a dict with every key in GATE_OUTPUTS.
    """
    current: state.FreshState = state.read(mobile_number)
    # >>> LLM_BODY:check
    otp_match = current.user_status == "active" and bool(otp_payload)
    return {"otp_match": otp_match, "policy_violation": not _within_device_limit(current)}
    # <<< LLM_BODY:check
