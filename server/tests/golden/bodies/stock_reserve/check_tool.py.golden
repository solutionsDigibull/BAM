"""Fixed check tool for Sub-Skill MS02.3_Stock_Reserver.

Generated by SBAM from template fastmcp-loopy 1.0.0.
Independent of the action tool: it re-reads state itself and never imports or calls the action.
Only the regions between the LLM_BODY markers are written by the LLM.
"""

from __future__ import annotations

from typing import Any

from . import state

TOOL_NAME = "check_reservation"
GATE_OUTPUTS: tuple[str, ...] = (
    "within_stock",
    "within_limit",
)

# >>> LLM_BODY:helpers
def _available(current: state.FreshState) -> int:
    return int(current.available_qty or 0) - int(current.reserved_qty or 0)
# <<< LLM_BODY:helpers


def check_reservation(
    sku: str,
    quantity: int,
) -> dict[str, Any]:
    """Pass when reserved quantity <= available_qty and quantity <= max_reserve.

    Must return a dict with every key in GATE_OUTPUTS.
    """
    current: state.FreshState = state.read(sku)
    # >>> LLM_BODY:check
    limit = int(state.PARAMETERS["max_reserve"])
    return {"within_stock": quantity <= _available(current), "within_limit": quantity <= limit}
    # <<< LLM_BODY:check
