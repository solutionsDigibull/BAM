"""Action tool for Sub-Skill MS02.3_Stock_Reserver.

Generated by SBAM from template fastmcp-loopy 1.0.0.
Only the regions between the LLM_BODY markers are written by the LLM.
"""

from __future__ import annotations

from typing import Any

from . import state, state_handoff

TOOL_NAME = "reserve_stock"

# >>> LLM_BODY:helpers
def _available(current: state.FreshState) -> int:
    return int(current.available_qty or 0) - int(current.reserved_qty or 0)
# <<< LLM_BODY:helpers


def reserve_stock(
    sku: str,
    quantity: int,
) -> dict[str, Any]:
    """Reserve quantity units of sku against the available stock, never more than max_reserve
    per call.

    Must call state_handoff.append(...) with: iteration_pass, sku, quantity.
    """
    current: state.FreshState = state.read(sku)
    # >>> LLM_BODY:action
    available = _available(current)
    limit = int(state.PARAMETERS["max_reserve"])
    reserved = 0 < quantity <= min(available, limit)
    state_handoff.append(iteration_pass=1, sku=sku, quantity=quantity if reserved else 0)
    return {"reserved": reserved, "remaining": available - quantity if reserved else available}
    # <<< LLM_BODY:action
