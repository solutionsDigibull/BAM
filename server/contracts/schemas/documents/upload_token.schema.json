{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:documents/upload_token:0.1.0",
  "$defs": {
    "AcceptedFile": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "mime": {
          "title": "Mime",
          "type": "string"
        }
      },
      "required": [
        "name",
        "size",
        "mime"
      ],
      "title": "AcceptedFile",
      "type": "object"
    },
    "ErrorCode": {
      "description": "Stable machine-readable error codes. Add new codes here; never rename or reuse one.",
      "enum": [
        "VALIDATION_ERROR",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "WRONG_PORTAL",
        "NOT_FOUND",
        "CONFLICT",
        "PRECONDITION_FAILED",
        "PRECONDITION_REQUIRED",
        "PAYLOAD_TOO_LARGE",
        "UNSUPPORTED_MEDIA_TYPE",
        "RESOURCE_LOCKED",
        "RATE_LIMITED",
        "SERVICE_UNAVAILABLE",
        "INTERNAL_ERROR",
        "IDEMPOTENCY_KEY_REUSED",
        "INVALID_CURSOR",
        "VERSION_CONFLICT",
        "INVALID_TRANSITION",
        "READ_ONLY",
        "GONE",
        "TENANT_MISMATCH",
        "TENANT_SUSPENDED",
        "IDP_UNAVAILABLE",
        "LAST_ADMIN",
        "USER_EXISTS",
        "DUPLICATE_NAME",
        "PROJECT_ARCHIVED",
        "DRAFT_EXISTS",
        "STRUCTURE_MISMATCH",
        "FILETYPE_FROZEN",
        "SNAPSHOT_PROJECT_MISMATCH",
        "SECRET_VALUE_NOT_ALLOWED",
        "FILE_TOO_LARGE",
        "FILE_LIMIT_REACHED",
        "UNSUPPORTED_TYPE",
        "INVALID_ENCODING",
        "NESTED_ARCHIVE",
        "ARCHIVE_LIMIT",
        "HASH_MISMATCH",
        "NO_DOCUMENTS",
        "PARSE_ERROR",
        "SCAN_UNAVAILABLE",
        "OCR_UNAVAILABLE",
        "MALWARE",
        "KNOWLEDGE_BUILDING",
        "KNOWLEDGE_NOT_READY",
        "COGNEE_ACL_DISABLED",
        "SOW_STALE",
        "SOW_LOCKED",
        "SOW_APPROVED",
        "SOW_NOT_APPROVED",
        "SOW_NOT_LATEST",
        "SOW_VERSION_CONFLICT",
        "NO_APPROVED_SOW",
        "NOT_IN_REVIEW",
        "PIPELINE_RUNNING",
        "PIPELINE_NOT_WAITING",
        "TEMPORAL_UNAVAILABLE",
        "ORCHESTRATOR_UNAVAILABLE",
        "ISATVON_CONTRACT",
        "SKILL_ID_PREFIX_MISMATCH",
        "MACRO_REQUIRES_SUB_SKILL",
        "GATE_PARSE_ERROR",
        "UNRESOLVED_IDENTIFIER",
        "TYPE_MISMATCH",
        "SCHEMA_PARSE_ERROR",
        "LIBRARY_NOT_IN_REGISTRY",
        "TOOLS_NOT_DECOUPLED",
        "WORKFLOW_BUILDING",
        "MIN_TEST_CASES",
        "MOCK_UNMATCHED",
        "WORKFLOW_FROZEN",
        "NOT_FROZEN"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "RejectedFile": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        }
      },
      "required": [
        "name",
        "code"
      ],
      "title": "RejectedFile",
      "type": "object"
    }
  },
  "properties": {
    "token": {
      "title": "Token",
      "type": "string"
    },
    "tus_endpoint": {
      "title": "Tus Endpoint",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "accepted": {
      "items": {
        "$ref": "#/$defs/AcceptedFile"
      },
      "title": "Accepted",
      "type": "array"
    },
    "rejected": {
      "items": {
        "$ref": "#/$defs/RejectedFile"
      },
      "title": "Rejected",
      "type": "array"
    }
  },
  "required": [
    "token",
    "tus_endpoint",
    "expires_at",
    "accepted",
    "rejected"
  ],
  "title": "UploadToken",
  "type": "object"
}
