{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:documents/parse_report:0.1.0",
  "additionalProperties": false,
  "description": "Kept on the document version (`parse_report`) after every parse attempt.",
  "properties": {
    "pages": {
      "default": 0,
      "minimum": 0,
      "title": "Pages",
      "type": "integer"
    },
    "sheets": {
      "default": 0,
      "minimum": 0,
      "title": "Sheets",
      "type": "integer"
    },
    "tables": {
      "default": 0,
      "minimum": 0,
      "title": "Tables",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "ocr_needed_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Ocr Needed Pages",
      "type": "array"
    },
    "ocr_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Ocr Pages",
      "type": "array"
    },
    "unreadable_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Unreadable Pages",
      "type": "array"
    }
  },
  "title": "ParseReport",
  "type": "object"
}
