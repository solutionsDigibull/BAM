{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:documents/parse_report:0.1.0",
  "$defs": {
    "AttachmentOutcome": {
      "description": "What became of one attachment of an e-mail (E4.6).",
      "enum": [
        "REGISTERED",
        "FILE_LIMIT_REACHED",
        "TOO_LARGE",
        "TOO_DEEP"
      ],
      "title": "AttachmentOutcome",
      "type": "string"
    },
    "AttachmentReport": {
      "additionalProperties": false,
      "description": "One attachment of a parsed e-mail, in `ParseReport.attachments` of the parent.",
      "properties": {
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "content_type": {
          "maxLength": 255,
          "title": "Content Type",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "outcome": {
          "$ref": "#/$defs/AttachmentOutcome"
        },
        "document_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        }
      },
      "required": [
        "name",
        "content_type",
        "size",
        "outcome"
      ],
      "title": "AttachmentReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Kept on the document version (`parse_report`) after every parse attempt.",
  "properties": {
    "pages": {
      "default": 0,
      "minimum": 0,
      "title": "Pages",
      "type": "integer"
    },
    "sheets": {
      "default": 0,
      "minimum": 0,
      "title": "Sheets",
      "type": "integer"
    },
    "tables": {
      "default": 0,
      "minimum": 0,
      "title": "Tables",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "ocr_needed_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Ocr Needed Pages",
      "type": "array"
    },
    "ocr_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Ocr Pages",
      "type": "array"
    },
    "unreadable_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Unreadable Pages",
      "type": "array"
    },
    "attachments": {
      "items": {
        "$ref": "#/$defs/AttachmentReport"
      },
      "title": "Attachments",
      "type": "array"
    }
  },
  "title": "ParseReport",
  "type": "object"
}
