{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:documents/parse_outcome:0.1.0",
  "$defs": {
    "AttachmentOutcome": {
      "description": "What became of one attachment of an e-mail (E4.6).",
      "enum": [
        "REGISTERED",
        "FILE_LIMIT_REACHED",
        "TOO_LARGE",
        "TOO_DEEP"
      ],
      "title": "AttachmentOutcome",
      "type": "string"
    },
    "AttachmentReport": {
      "additionalProperties": false,
      "description": "One attachment of a parsed e-mail, in `ParseReport.attachments` of the parent.",
      "properties": {
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "content_type": {
          "maxLength": 255,
          "title": "Content Type",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "outcome": {
          "$ref": "#/$defs/AttachmentOutcome"
        },
        "document_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        }
      },
      "required": [
        "name",
        "content_type",
        "size",
        "outcome"
      ],
      "title": "AttachmentReport",
      "type": "object"
    },
    "ErrorCode": {
      "description": "Stable machine-readable error codes. Add new codes here; never rename or reuse one.",
      "enum": [
        "VALIDATION_ERROR",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "WRONG_PORTAL",
        "NOT_FOUND",
        "CONFLICT",
        "PRECONDITION_FAILED",
        "PRECONDITION_REQUIRED",
        "PAYLOAD_TOO_LARGE",
        "UNSUPPORTED_MEDIA_TYPE",
        "RESOURCE_LOCKED",
        "RATE_LIMITED",
        "SERVICE_UNAVAILABLE",
        "INTERNAL_ERROR",
        "IDEMPOTENCY_KEY_REUSED",
        "INVALID_CURSOR",
        "VERSION_CONFLICT",
        "INVALID_TRANSITION",
        "READ_ONLY",
        "GONE",
        "TENANT_MISMATCH",
        "TENANT_SUSPENDED",
        "IDP_UNAVAILABLE",
        "LAST_ADMIN",
        "USER_EXISTS",
        "DUPLICATE_NAME",
        "PROJECT_ARCHIVED",
        "DRAFT_EXISTS",
        "STRUCTURE_MISMATCH",
        "FILETYPE_FROZEN",
        "SNAPSHOT_PROJECT_MISMATCH",
        "SECRET_VALUE_NOT_ALLOWED",
        "FILE_TOO_LARGE",
        "FILE_LIMIT_REACHED",
        "UNSUPPORTED_TYPE",
        "INVALID_ENCODING",
        "NESTED_ARCHIVE",
        "ARCHIVE_LIMIT",
        "HASH_MISMATCH",
        "NO_DOCUMENTS",
        "PARSE_ERROR",
        "CORRUPT",
        "ENCRYPTED",
        "EMPTY",
        "TIMEOUT",
        "SCAN_UNAVAILABLE",
        "OCR_UNAVAILABLE",
        "MALWARE",
        "KNOWLEDGE_BUILDING",
        "KNOWLEDGE_NOT_READY",
        "COGNEE_ACL_DISABLED",
        "SOW_STALE",
        "SOW_LOCKED",
        "SOW_APPROVED",
        "SOW_NOT_APPROVED",
        "SOW_NOT_LATEST",
        "SOW_VERSION_CONFLICT",
        "SOW_GENERATING",
        "EXPORT_TIMEOUT",
        "NO_APPROVED_SOW",
        "NOT_IN_REVIEW",
        "PIPELINE_RUNNING",
        "PIPELINE_NOT_WAITING",
        "TEMPORAL_UNAVAILABLE",
        "ORCHESTRATOR_UNAVAILABLE",
        "ISATVON_CONTRACT",
        "SKILL_ID_PREFIX_MISMATCH",
        "MACRO_REQUIRES_SUB_SKILL",
        "GATE_PARSE_ERROR",
        "UNRESOLVED_IDENTIFIER",
        "TYPE_MISMATCH",
        "SCHEMA_PARSE_ERROR",
        "LIBRARY_NOT_IN_REGISTRY",
        "TOOLS_NOT_DECOUPLED",
        "WORKFLOW_BUILDING",
        "MIN_TEST_CASES",
        "MOCK_UNMATCHED",
        "WORKFLOW_FROZEN",
        "NOT_FROZEN"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ParseReport": {
      "additionalProperties": false,
      "description": "Kept on the document version (`parse_report`) after every parse attempt.",
      "properties": {
        "pages": {
          "default": 0,
          "minimum": 0,
          "title": "Pages",
          "type": "integer"
        },
        "sheets": {
          "default": 0,
          "minimum": 0,
          "title": "Sheets",
          "type": "integer"
        },
        "tables": {
          "default": 0,
          "minimum": 0,
          "title": "Tables",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "ocr_needed_pages": {
          "items": {
            "type": "integer"
          },
          "title": "Ocr Needed Pages",
          "type": "array"
        },
        "ocr_pages": {
          "items": {
            "type": "integer"
          },
          "title": "Ocr Pages",
          "type": "array"
        },
        "unreadable_pages": {
          "items": {
            "type": "integer"
          },
          "title": "Unreadable Pages",
          "type": "array"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentReport"
          },
          "title": "Attachments",
          "type": "array"
        }
      },
      "title": "ParseReport",
      "type": "object"
    }
  },
  "description": "Result of the `parse_document` activity. `code` is set when the version is PARSE_FAILED.",
  "properties": {
    "document_version_id": {
      "format": "uuid",
      "title": "Document Version Id",
      "type": "string"
    },
    "parsed": {
      "title": "Parsed",
      "type": "boolean"
    },
    "code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParseReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "document_version_id",
    "parsed"
  ],
  "title": "ParseOutcome",
  "type": "object"
}
