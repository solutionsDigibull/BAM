{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:projects/project_goal:0.1.0",
  "$defs": {
    "GoalIsatvonSection": {
      "description": "One row of the ISATVON template shown under the FDE's goal (#798).",
      "properties": {
        "key": {
          "$ref": "#/$defs/IsatvonKey"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "text"
      ],
      "title": "GoalIsatvonSection",
      "type": "object"
    },
    "IsatvonKey": {
      "enum": [
        "I",
        "S",
        "A",
        "T",
        "V",
        "O",
        "N"
      ],
      "title": "IsatvonKey",
      "type": "string"
    }
  },
  "description": "`GET` / `PUT /projects/{id}/goal`: the project's goal (None before one is set) and the\nISATVON template shown under it (#798; empty while no goal is set). The ETag header is the\nproject's `row_version`.",
  "properties": {
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "goal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Goal"
    },
    "isatvon": {
      "items": {
        "$ref": "#/$defs/GoalIsatvonSection"
      },
      "title": "Isatvon",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "goal"
  ],
  "title": "ProjectGoalOut",
  "type": "object"
}
