{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:projects/project_goal_put:0.1.0",
  "additionalProperties": false,
  "description": "`PUT /projects/{id}/goal` with `If-Match` (#720): the new goal; `null` clears it.",
  "properties": {
    "goal": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Goal"
    }
  },
  "required": [
    "goal"
  ],
  "title": "ProjectGoalPut",
  "type": "object"
}
