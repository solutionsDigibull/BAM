{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:projects/project_patch:0.1.0",
  "additionalProperties": false,
  "description": "Partial update: only the fields sent change. `null` clears an optional field.",
  "properties": {
    "name": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "client_name": {
      "anyOf": [
        {
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Name"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "context_notes": {
      "anyOf": [
        {
          "maxLength": 10000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Notes"
    }
  },
  "title": "ProjectPatch",
  "type": "object"
}
