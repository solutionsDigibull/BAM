{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:identity/user_invite:0.1.0",
  "additionalProperties": false,
  "properties": {
    "email": {
      "format": "email",
      "maxLength": 254,
      "title": "Email",
      "type": "string"
    },
    "roles": {
      "items": {
        "enum": [
          "sbam-admin",
          "sbam-fde"
        ],
        "type": "string"
      },
      "title": "Roles",
      "type": "array"
    }
  },
  "required": [
    "email",
    "roles"
  ],
  "title": "UserInvite",
  "type": "object"
}
