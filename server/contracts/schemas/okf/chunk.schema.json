{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:okf/chunk:0.1.0",
  "$defs": {
    "Location": {
      "additionalProperties": false,
      "description": "Where a chunk is in its source (E4.5's doc.json provenance). `scope` is `document` when only\nthe whole document is known (no doc.json, or an entity found in no block).",
      "properties": {
        "scope": {
          "default": "block",
          "enum": [
            "block",
            "document"
          ],
          "title": "Scope",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "cell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        }
      },
      "title": "Location",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "document_version_id": {
      "format": "uuid",
      "title": "Document Version Id",
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "ocr": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ocr"
    },
    "unreadable": {
      "default": false,
      "title": "Unreadable",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "document_version_id",
    "location",
    "text"
  ],
  "title": "OkfChunk",
  "type": "object"
}
