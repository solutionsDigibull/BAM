{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:okf/coverage:0.1.0",
  "$defs": {
    "CoverageStatus": {
      "enum": [
        "COVERED",
        "CHUNKS_ONLY",
        "FAILED"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "DocumentCoverage": {
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "chunks": {
          "default": 0,
          "minimum": 0,
          "title": "Chunks",
          "type": "integer"
        },
        "entities": {
          "default": 0,
          "minimum": 0,
          "title": "Entities",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "document_version_id",
        "status"
      ],
      "title": "DocumentCoverage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "documents": {
      "items": {
        "$ref": "#/$defs/DocumentCoverage"
      },
      "title": "Documents",
      "type": "array"
    },
    "dropped_entities": {
      "default": 0,
      "minimum": 0,
      "title": "Dropped Entities",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "documents"
  ],
  "title": "BundleCoverage",
  "type": "object"
}
