{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:testgen/case_post:0.1.0",
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "description": "An expectation beyond the terminal state and the output (an `N` assertion: the `ui_updates`\nthe harness must emit, a handoff row, a pass count).",
      "properties": {
        "type": {
          "pattern": "^[a-z][a-z0-9_]{0,59}$",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "type"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "ExpectedTerminal": {
      "enum": [
        "SUCCESS",
        "ESCALATED",
        "NO_OP"
      ],
      "title": "ExpectedTerminal",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "`POST W/sub-skills/{sub_id}/tests/cases` with `If-Match`: a new case; the server sets the\nkind (`FDE`), so it is not part of the body.",
  "properties": {
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "input": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Input",
      "type": "object"
    },
    "initial_state": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 500,
      "title": "Initial State",
      "type": "array"
    },
    "state_script": {
      "items": {
        "items": {
          "maxLength": 20000,
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "maxItems": 10,
      "title": "State Script",
      "type": "array"
    },
    "expected_terminal": {
      "$ref": "#/$defs/ExpectedTerminal"
    },
    "expected_output": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Output"
    },
    "assertions": {
      "items": {
        "$ref": "#/$defs/Assertion"
      },
      "maxItems": 50,
      "title": "Assertions",
      "type": "array"
    }
  },
  "required": [
    "name",
    "input",
    "expected_terminal"
  ],
  "title": "CasePost",
  "type": "object"
}
