{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:manifest/manifest_version_list:0.1.0",
  "$defs": {
    "ManifestVersion": {
      "additionalProperties": false,
      "description": "One stored manifest: a Sub-Skill build stage key, or a Workflow build.",
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "build_no": {
          "title": "Build No",
          "type": "integer"
        },
        "cycle": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycle"
        },
        "attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "is_frozen": {
          "title": "Is Frozen",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "version",
        "sha256",
        "build_no",
        "is_frozen",
        "created_at"
      ],
      "title": "ManifestVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ManifestVersion"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "ManifestVersionList",
  "type": "object"
}
