{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:budget/meter:0.1.0",
  "$defs": {
    "BudgetLevel": {
      "enum": [
        "OK",
        "FIRST_ALERT",
        "SECOND_ALERT",
        "STOPPED"
      ],
      "title": "BudgetLevel",
      "type": "string"
    },
    "BudgetScope": {
      "enum": [
        "SUB_SKILL",
        "WORKFLOW",
        "KNOWLEDGE"
      ],
      "title": "BudgetScope",
      "type": "string"
    },
    "BudgetState": {
      "additionalProperties": false,
      "description": "What one build has used, as the workbench meter and the alerts read it.",
      "properties": {
        "scope": {
          "$ref": "#/$defs/BudgetScope"
        },
        "used": {
          "minimum": 0,
          "title": "Used",
          "type": "integer"
        },
        "cap": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Cap",
          "type": "integer"
        },
        "level": {
          "$ref": "#/$defs/BudgetLevel"
        },
        "raised_once": {
          "default": false,
          "title": "Raised Once",
          "type": "boolean"
        },
        "build_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Id"
        }
      },
      "required": [
        "scope",
        "used",
        "cap",
        "level"
      ],
      "title": "BudgetState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`GET /projects/{id}/token-budget` (#776): used against the cap per scope, for the meter.",
  "properties": {
    "scopes": {
      "items": {
        "$ref": "#/$defs/BudgetState"
      },
      "title": "Scopes",
      "type": "array"
    },
    "first_alert_pct": {
      "maximum": 98,
      "minimum": 1,
      "title": "First Alert Pct",
      "type": "integer"
    },
    "second_alert_pct": {
      "maximum": 99,
      "minimum": 2,
      "title": "Second Alert Pct",
      "type": "integer"
    }
  },
  "required": [
    "scopes",
    "first_alert_pct",
    "second_alert_pct"
  ],
  "title": "TokenMeter",
  "type": "object"
}
