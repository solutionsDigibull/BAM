{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:budget/caps:0.1.0",
  "additionalProperties": false,
  "description": "A project's caps.\n\nEvery field has the ADR 0028 default, so `BudgetCaps()` is the platform default.",
  "properties": {
    "sub_skill_tokens": {
      "default": 200000,
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Sub Skill Tokens",
      "type": "integer"
    },
    "workflow_tokens": {
      "default": 2000000,
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Workflow Tokens",
      "type": "integer"
    },
    "knowledge_tokens": {
      "default": 30000000,
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Knowledge Tokens",
      "type": "integer"
    },
    "first_alert_pct": {
      "default": 50,
      "maximum": 98,
      "minimum": 1,
      "title": "First Alert Pct",
      "type": "integer"
    },
    "second_alert_pct": {
      "default": 80,
      "maximum": 99,
      "minimum": 2,
      "title": "Second Alert Pct",
      "type": "integer"
    }
  },
  "title": "BudgetCaps",
  "type": "object"
}
