{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:masters/master_entry_create:0.1.0",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "row_label": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^\\S.*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Row Label"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    }
  },
  "required": [
    "payload"
  ],
  "title": "MasterEntryCreate",
  "type": "object"
}
