{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:masters/readme:0.1.0",
  "additionalProperties": false,
  "description": "The README tab: help text. Only its structure is checked, its content is not interpreted.",
  "properties": {
    "title": {
      "maxLength": 32767,
      "pattern": "^BuLLM - Admin Masters \\(BAM\\)",
      "title": "Title",
      "type": "string"
    },
    "rows": {
      "items": {
        "items": {
          "anyOf": [
            {
              "maxLength": 32767,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxItems": 4,
        "type": "array"
      },
      "title": "Rows",
      "type": "array"
    }
  },
  "required": [
    "title",
    "rows"
  ],
  "structure_version": "BAM 0.2",
  "title": "ReadmeTab",
  "type": "object"
}
