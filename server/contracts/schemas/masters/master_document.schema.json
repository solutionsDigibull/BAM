{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:masters/master_document:0.1.0",
  "$defs": {
    "ErrorCode": {
      "description": "Stable machine-readable error codes. Add new codes here; never rename or reuse one.",
      "enum": [
        "VALIDATION_ERROR",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "WRONG_PORTAL",
        "NOT_FOUND",
        "CONFLICT",
        "PRECONDITION_FAILED",
        "PRECONDITION_REQUIRED",
        "PAYLOAD_TOO_LARGE",
        "UNSUPPORTED_MEDIA_TYPE",
        "RESOURCE_LOCKED",
        "RATE_LIMITED",
        "SERVICE_UNAVAILABLE",
        "INTERNAL_ERROR",
        "IDEMPOTENCY_KEY_REUSED",
        "INVALID_CURSOR",
        "VERSION_CONFLICT",
        "INVALID_TRANSITION",
        "READ_ONLY",
        "GONE",
        "TENANT_MISMATCH",
        "TENANT_SUSPENDED",
        "IDP_UNAVAILABLE",
        "LAST_ADMIN",
        "USER_EXISTS",
        "DUPLICATE_NAME",
        "PROJECT_ARCHIVED",
        "DRAFT_EXISTS",
        "STRUCTURE_MISMATCH",
        "FILETYPE_FROZEN",
        "SNAPSHOT_PROJECT_MISMATCH",
        "SECRET_VALUE_NOT_ALLOWED",
        "FILE_TOO_LARGE",
        "FILE_LIMIT_REACHED",
        "UNSUPPORTED_TYPE",
        "INVALID_ENCODING",
        "NESTED_ARCHIVE",
        "ARCHIVE_LIMIT",
        "PATH_UNSAFE",
        "HASH_MISMATCH",
        "NO_DOCUMENTS",
        "PARSE_ERROR",
        "CORRUPT",
        "ENCRYPTED",
        "EMPTY",
        "TIMEOUT",
        "SCAN_UNAVAILABLE",
        "OCR_UNAVAILABLE",
        "MALWARE",
        "KNOWLEDGE_BUILDING",
        "KNOWLEDGE_NOT_READY",
        "COGNEE_ACL_DISABLED",
        "SOW_STALE",
        "SOW_LOCKED",
        "SOW_APPROVED",
        "SOW_NOT_APPROVED",
        "SOW_NOT_LATEST",
        "SOW_VERSION_CONFLICT",
        "SOW_GENERATING",
        "EXPORT_TIMEOUT",
        "NO_APPROVED_SOW",
        "NOT_IN_REVIEW",
        "PIPELINE_RUNNING",
        "PIPELINE_NOT_WAITING",
        "TEMPORAL_UNAVAILABLE",
        "ORCHESTRATOR_UNAVAILABLE",
        "ISATVON_CONTRACT",
        "SKILL_ID_PREFIX_MISMATCH",
        "MACRO_REQUIRES_SUB_SKILL",
        "GATE_PARSE_ERROR",
        "UNRESOLVED_IDENTIFIER",
        "TYPE_MISMATCH",
        "SCHEMA_PARSE_ERROR",
        "LIBRARY_NOT_IN_REGISTRY",
        "TOOLS_NOT_DECOUPLED",
        "WORKFLOW_BUILDING",
        "DAG_CYCLE",
        "SCHEMA_SQL_MISSING",
        "MIN_TEST_CASES",
        "MOCK_UNMATCHED",
        "WORKFLOW_FROZEN",
        "NOT_FROZEN"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ParseStatus": {
      "enum": [
        "PENDING",
        "PARSING",
        "PARSED",
        "FAILED"
      ],
      "title": "ParseStatus",
      "type": "string"
    },
    "RouteSource": {
      "enum": [
        "DEFAULT_BY_FILETYPE",
        "ADMIN_OVERRIDE",
        "CLASSIFIER"
      ],
      "title": "RouteSource",
      "type": "string"
    },
    "ScanStatus": {
      "enum": [
        "CLEAN",
        "INFECTED",
        "SCAN_FAILED"
      ],
      "title": "ScanStatus",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "filetype_row_label": {
      "title": "Filetype Row Label",
      "type": "string"
    },
    "intent_class": {
      "title": "Intent Class",
      "type": "string"
    },
    "master_type": {
      "enum": [
        "ORGANIZATION",
        "RULES",
        "AGENTS",
        "SKILLS"
      ],
      "title": "Master Type",
      "type": "string"
    },
    "master_entry_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Master Entry Id"
    },
    "route_source": {
      "$ref": "#/$defs/RouteSource"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "size": {
      "title": "Size",
      "type": "integer"
    },
    "scan_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScanStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parse_status": {
      "$ref": "#/$defs/ParseStatus"
    },
    "parse_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "filetype_row_label",
    "intent_class",
    "master_type",
    "route_source",
    "sha256",
    "size",
    "parse_status",
    "created_at"
  ],
  "title": "MasterDocumentOut",
  "type": "object"
}
