{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:masters/master_status_change:0.1.0",
  "$defs": {
    "MasterStatus": {
      "enum": [
        "PROPOSED",
        "ILLUSTRATIVE",
        "APPROVED",
        "RETIRED"
