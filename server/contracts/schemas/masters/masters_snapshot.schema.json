{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:masters/masters_snapshot:0.1.0",
  "$defs": {
    "MasterStatus": {
      "enum": [
        "PROPOSED",
        "ILLUSTRATIVE",
        "APPROVED",
        "RETIRED"
      ],
      "title": "MasterStatus",
      "type": "string"
    },
    "MasterType": {
      "enum": [
        "ORGANIZATION",
        "RULES",
        "AGENTS",
        "SKILLS",
        "TOOLING",
        "FILETYPE"
      ],
      "title": "MasterType",
      "type": "string"
    },
    "SnapshotDocument": {
      "description": "One parsed master document pinned by a snapshot (E3.8b): the file's content hash and the key\nof its `doc.md`, so a build reads exactly what was pinned. The Admin attached it as context for\none master; it never counts as an FDE source (C3).",
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "master_type": {
          "$ref": "#/$defs/MasterType"
        },
        "intent_class": {
          "title": "Intent Class",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "derived_md_key": {
          "title": "Derived Md Key",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "title",
        "master_type",
        "intent_class",
        "sha256",
        "derived_md_key"
      ],
      "title": "SnapshotDocument",
      "type": "object"
    },
    "SnapshotEntry": {
      "description": "One pinned entry. The snapshot pins every live entry of the project; whoever uses it decides\ninclusion from `status` and `restricted` (E3.6: ILLUSTRATIVE / RETIRED never, Restricted only\nwhen the project allows it).",
      "properties": {
        "entry_id": {
          "format": "uuid",
          "title": "Entry Id",
          "type": "string"
        },
        "master_type": {
          "$ref": "#/$defs/MasterType"
        },
        "stable_id": {
          "title": "Stable Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/MasterStatus"
        },
        "restricted": {
          "default": false,
          "title": "Restricted",
          "type": "boolean"
        }
      },
      "required": [
        "entry_id",
        "master_type",
        "stable_id",
        "version",
        "status"
      ],
      "title": "SnapshotEntry",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SnapshotEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/SnapshotDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "project_id",
    "entries",
    "sha256",
    "created_at"
  ],
  "title": "MastersSnapshot",
  "type": "object"
}
