{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbam:contracts:code/file_view:0.1.0",
  "$defs": {
    "CodeFinding": {
      "additionalProperties": false,
      "description": "One gate finding (the shape E11.3 / E12.2 write into `code_attempts.findings`).",
      "properties": {
        "gate": {
          "title": "Gate",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "col": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "code",
        "message"
      ],
      "title": "CodeFinding",
      "type": "object"
    },
    "LineRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "LineRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "path": {
      "title": "Path",
      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "content": {
      "title": "Content",
      "type": "string"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "slots": {
      "items": {
        "$ref": "#/$defs/LineRange"
      },
      "title": "Slots",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/CodeFinding"
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "path",
    "sha256",
    "content",
    "truncated",
    "slots",
    "findings"
  ],
  "title": "CodeFileView",
  "type": "object"
}
