  "additionalProperties": false,
  "description": "One Sub-Skill row: ISATVON 1.4 content plus the platform fields the grid shows read-only.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "macro_id": {
      "format": "uuid",
      "title": "Macro Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/SubSkillState"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "validation_errors": {
      "items": {
        "$ref": "#/$defs/RuleViolation"
