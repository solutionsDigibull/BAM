{#
  Fresh-state reader (TD §12.3, §15.2). Template fastmcp-loopy 1.0.0 (E11.1).
  Context: skill_id, template_version, key_field, parameters [{name, value}], fresh_state [str].
  Both tools call state.read(key) at the start of every iteration, so each one sees fresh state
  and the check tool never depends on what the action tool returned.
  The LLM fills only QUERIES (slot LLM_BODY:state_queries): parameterised SELECT strings,
  one %s placeholder each, named after a fresh_state parameter. The assembler writes the
  dict literal itself (data, not code). read() is fixed: it binds the key as the only parameter
  and refuses anything that is not a single-placeholder SELECT.
  With zero fresh_state parameters FreshState is an empty model and QUERIES stays empty.
#}
"""Fresh-state reader for Sub-Skill {{ skill_id | docstring }}.

Generated by SBAM from template fastmcp-loopy {{ template_version | docstring }}.
Read-only: every query is a parameterised SELECT keyed by {{ key_field | identifier }}.
Only the region between the LLM_BODY markers is written by the LLM.
"""

from __future__ import annotations

from typing import Any

from pydantic import BaseModel, ConfigDict

# V parameters (bounds such as max_device_limit). Bodies read them from here, never hard-code.
{% if parameters %}
PARAMETERS: dict[str, Any] = {
{% for p in parameters %}
    {{ p.name | identifier | python_literal }}: {{ p.value | python_literal }},
{% endfor %}
}
{% else %}
PARAMETERS: dict[str, Any] = {}
{% endif %}
{% if fresh_state | length > 1 %}
FRESH_STATE: tuple[str, ...] = (
{% for f in fresh_state %}
    {{ f | identifier | python_literal }},
{% endfor %}
)
{% elif fresh_state %}
FRESH_STATE: tuple[str, ...] = ({{ fresh_state[0] | identifier | python_literal }},)
{% else %}
FRESH_STATE: tuple[str, ...] = ()
{% endif %}


class FreshState(BaseModel):
    """The fresh-state parameters, re-read from the database every iteration."""

    model_config = ConfigDict(extra="forbid", frozen=True)
{% if fresh_state %}

{% endif %}
{% for f in fresh_state %}
    {{ f | identifier }}: Any = None
{% endfor %}


QUERIES: dict[str, str]
# >>> LLM_BODY:state_queries
{% if fresh_state %}
raise NotImplementedError("LLM_BODY:state_queries")
{% else %}
QUERIES = {}
{% endif %}
# <<< LLM_BODY:state_queries

_conn: Any = None


def configure(conn: Any) -> None:
    """Inject a DB-API connection. It must be safe to use from FastMCP's worker threads."""
    global _conn
    _conn = conn


def read(key: Any) -> FreshState:
    """Run every query in QUERIES with key bound as the only parameter."""
    if _conn is None:
        raise RuntimeError("state.configure(conn) was not called")
    values: dict[str, Any] = {}
    for name, sql in QUERIES.items():
        if not sql.lstrip().upper().startswith("SELECT") or sql.count("%s") != 1:
            raise ValueError(f"state query {name!r} must be a SELECT with exactly one %s")
        row = _conn.execute(sql, (key,)).fetchone()
        values[name] = row[0] if row else None
    return FreshState(**values)
