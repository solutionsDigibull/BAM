{
  "skill_metadata": {
    "macro_category": "MS04_Manufacturing_Supply_Chain",
    "skill_id": "MS04.2_BOM_Scrubber",
    "skill_name": "SK-BOM Scrub: BOM line normaliser",
    "skill_type": "Deterministic_Loopy_MCP",
    "reusable": true,
    "version": "1.0.0",
    "status": "APPROVED",
    "owner": "Supply Chain Engineering",
    "created_at": "2026-06-29T12:00:00Z",
    "updated_at": "2026-06-29T12:00:00Z"
  },
  "isatvon_definition": {
    "i_instructions": "Triggered when a BOM revision is uploaded. Action: normalise BOM lines and merge duplicate part numbers. Check: every line resolves to an active part in the part master. Bound: at most 2 scrub passes before escalating to the BOM owner.",
    "s_source": {
      "required_inputs": [
        "bom_id",
        "line_count",
        "supplier_code",
        "strict_mode"
      ],
      "fresh_state_parameters": [
        "Current scrub_passes for the BOM",
        "Open line count in bom_lines"
      ]
    },
    "a_automation": {
      "orchestration_layer": "BuLLM_DMR",
      "action_step": "Normalise each BOM line (trim, upper-case part numbers, unit \"EA\" default) and merge duplicates.",
      "acceptance_check": "Programmatically evaluate if unresolved_lines == 0 AND duplicate_parts == 0 against the part master.",
      "trigger_mode": "HTTP_POST_Payload_plus_Variables"
    },
    "t_tech_stack": {
      "execution_layer": "FastMCP",
      "action_tool": "BOM_MCP (Line Normaliser)",
      "fixed_check_tool": "PLM_MCP (Part Master Validator)"
    },
    "v_variables": {
      "max_iterations": 2,
      "success_gate": "unresolved_lines == 0 AND duplicate_parts == 0",
      "no_op_condition": "bom status is already 'RELEASED'",
      "escalation_condition": "scrub_passes >= max_iterations",
      "budget_limit": "10000ms per scrub pass",
      "tables": [
        "bom_lines",
        "bom_scrub_audit_handoff"
      ]
    },
    "o_outcome": {
      "json_schema": {
        "scrub_status": [
          "CLEAN",
          "NEEDS_REVIEW",
          "ESCALATED"
        ],
        "unresolved_lines": "integer",
        "duplicate_parts": "integer"
      },
      "state_handoff_file": {
        "table": "bom_scrub_audit_handoff",
        "mode": "append_only",
        "required_fields": [
          "iteration_pass",
          "bom_id",
          "unresolved_lines",
          "duplicate_parts"
        ],
        "description": "Log the scrub pass, BOM id and the unresolved / duplicate counts."
      },
      "success_criteria": "No unresolved lines and no duplicate parts within 2 passes"
    },
    "n_notification": {
      "ui_updates": [
        "Status: Scrubbing -> Looping [Pass 1/2]: 3 unresolved -> Clean",
        "Status: Escalated - BOM owner review"
      ],
      "database_updates": [
        "Append scrub evidence to bom_scrub_audit_handoff"
      ],
      "alerts": [
        "Notify the BOM owner on escalation"
      ],
      "next": null
    }
  },
  "srim_runtime_definition": {
    "orchestration": {
      "router": "Dify_Dynamic_Master_Router",
