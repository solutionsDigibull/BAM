  Append-only handoff writer (TD §12.3, ISATVON 1.4 O: state_handoff.required_fields). Spike E0.11 (#29).
  Context: skill_id, handoff_table, required_fields [str], template_version
  (from o_outcome.state_handoff_file: table, required_fields; mode must be append_only).
  No slot: this file is 100% template. The action tool must call append(...) with every
  required field (AST_HANDOFF checks the call site; append() checks again at runtime).
  It only ever INSERTs: rows are never updated or deleted, so the audit trail cannot be rewritten.
#}
"""Append-only state handoff for Sub-Skill {{ skill_id | docstring }}.

Generated by SBAM from template fastmcp-loopy {{ template_version | docstring }}.
Fully template-owned: the LLM writes nothing here. Rows are only ever inserted.
"""

from __future__ import annotations

import json
from typing import Any

SKILL_ID = {{ skill_id | pylit }}
TABLE = {{ handoff_table | pyident | pylit }}
_INSERT = {{ ("INSERT INTO " ~ (handoff_table | pyident) ~ " (skill_id, payload) VALUES (?, ?)") | pylit }}
REQUIRED_FIELDS = (
{% for f in required_fields %}
    {{ f | pylit }},
{% endfor %}
)

_conn: Any = None


def configure(conn: Any) -> None:
    """Inject a DB-API connection that has TABLE(skill_id TEXT, payload TEXT)."""
    global _conn
    _conn = conn


def append(**fields: Any) -> dict[str, Any]:
    """Insert one handoff row. Every REQUIRED_FIELDS key must be present, and no other key."""
    if _conn is None:
        raise RuntimeError("state_handoff.configure(conn) was not called")
    missing = [f for f in REQUIRED_FIELDS if f not in fields]
    unknown = sorted(set(fields) - set(REQUIRED_FIELDS))
    if missing or unknown:
        raise ValueError(f"state_handoff: missing={missing} unknown={unknown}")
    payload = json.dumps(fields, sort_keys=True, default=str)
    # _INSERT is fixed at render time; TABLE went through pyident, so it is never manifest SQL.
    _conn.execute(_INSERT, (SKILL_ID, payload))
    return fields
