{#
  Fresh-state reader (TD §12.3, §15.2). Spike E0.11 (#29).
  Context: skill_id, inputs [{name, type}], parameters [{name, value}], fresh_state [str],
  template_version.
  Both tools call state.read(key) at the start of every iteration, so each one sees fresh state
  and the check tool never depends on what the action tool returned.
  The LLM fills only QUERIES (slot LLM_BODY:state_queries): parameterised SELECT strings.
  read() is fixed: it binds the key as a parameter and refuses anything that is not a SELECT.
#}
"""Fresh-state reader for Sub-Skill {{ skill_id | docstring }}.

Generated by SBAM from template fastmcp-loopy {{ template_version | docstring }}.
Read-only: every query is a parameterised SELECT keyed by {{ inputs[0].name | pyident }}.
Only the region between the LLM_BODY markers is written by the LLM.
"""

from __future__ import annotations

from typing import Any

# V parameters (bounds such as max_device_limit) and the fresh-state names QUERIES must cover.
PARAMETERS: dict[str, Any] = {
{% for p in parameters %}
    {{ p.name | pyident | pylit }}: {{ p.value | pyvalue }},
{% endfor %}
}
FRESH_STATE = (
{% for f in fresh_state %}
    {{ f | pyident | pylit }},
{% endfor %}
)

_conn: Any = None

# >>> LLM_BODY:state_queries
QUERIES: dict[str, str] = {}
# <<< LLM_BODY:state_queries


def configure(conn: Any) -> None:
    """Inject a DB-API connection (sqlite3 in tests, Postgres in the sandbox)."""
    global _conn
    _conn = conn


def read(key: str) -> dict[str, Any]:
    """Run every query in QUERIES with key bound as the only parameter; return name -> value."""
    if _conn is None:
        raise RuntimeError("state.configure(conn) was not called")
    result: dict[str, Any] = {}
    for name, sql in QUERIES.items():
        if not sql.lstrip().upper().startswith("SELECT"):
            raise ValueError(f"state query {name!r} is not a SELECT")
        row = _conn.execute(sql, (key,)).fetchone()
        result[name] = row[0] if row else None
    return result
