{#
  FastMCP server (TD §12.3). Spike E0.11 (#29).
  Context: skill_id, action_tool, fixed_check_tool, inputs [{name, type}], template_version.
  No slot: 100% template. Registers exactly two tools (action + fixed check), named after the
  manifest's T.action_tool / T.fixed_check_tool, and validates every call with models.SkillInput
  before the tool body runs. There is no loop here: iterations are driven by the runner
  (Temporal / SRIM) using V.max_iterations, never by generated code (AST_NO_MANUAL_LOOP).
#}
{% set PYTYPE = {"string": "str", "integer": "int", "number": "float", "boolean": "bool"} %}
{% set ACTION = action_tool | pyident %}
{% set CHECK = fixed_check_tool | pyident %}
"""FastMCP server for Sub-Skill {{ skill_id | docstring }}.

Generated by SBAM from template fastmcp-loopy {{ template_version | docstring }}.
Fully template-owned: the LLM writes nothing here.
"""

from __future__ import annotations

from typing import Any

from fastmcp import FastMCP

from . import action_tool, check_tool, models

SKILL_ID = {{ skill_id | pylit }}

mcp = FastMCP(SKILL_ID)


@mcp.tool(name={{ ACTION | pylit }})
def {{ ACTION }}(
{% for p in inputs %}
    {{ p.name | pyident }}: {{ PYTYPE[p.type] }},
{% endfor %}
) -> dict[str, Any]:
    """Action tool: {{ action_tool | docstring }}."""
    args = models.SkillInput(
{% for p in inputs %}
        {{ p.name | pyident }}={{ p.name | pyident }},
{% endfor %}
    )
    return action_tool.{{ ACTION }}(**args.model_dump())


@mcp.tool(name={{ CHECK | pylit }})
def {{ CHECK }}(
{% for p in inputs %}
    {{ p.name | pyident }}: {{ PYTYPE[p.type] }},
{% endfor %}
) -> dict[str, Any]:
    """Fixed check tool: {{ fixed_check_tool | docstring }}."""
    args = models.SkillInput(
{% for p in inputs %}
        {{ p.name | pyident }}={{ p.name | pyident }},
{% endfor %}
    )
    return check_tool.{{ CHECK }}(**args.model_dump())


if __name__ == "__main__":
    mcp.run()
