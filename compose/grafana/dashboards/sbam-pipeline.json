          "expr": "sum(increase(sbam_subskill_builds_total{outcome=\"needs_fde_review\"}[24h]))",
          "legendFormat": "needs review",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
