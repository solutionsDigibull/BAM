{
  "uid": "sbam-pipeline",
  "title": "SBAM / Pipeline, gates and corrections",
  "description": "Pipeline throughput, gate pass rate per gate and correction rate.",
  "tags": [
    "sbam"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Correction rate (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(increase(sbam_codegen_attempts_total{attempt=\"correction\"}[24h])) / sum(increase(sbam_codegen_attempts_total{attempt=\"initial\"}[24h]))",
          "legendFormat": "corrections per initial attempt",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Correction attempts as a share of first-attempt generations."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sub-Skills needing FDE review (24h)",
