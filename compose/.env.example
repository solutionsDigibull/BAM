# --- Host ports (optional). Every port binds to 127.0.0.1 only; change one if it is taken. ---
WEB_PORT=3000
API_PORT=8000
KEYCLOAK_PORT=8080
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TUSD_PORT=1080
BIFROST_PORT=8081
POSTGRES_PORT=5432
# Dev only (compose.override.yaml): Mailpit inbox for Keycloak invite and password emails.
MAILPIT_PORT=8025

# --- PostgreSQL (required). One login role per database, created by compose/postgres/init.sh. ---
POSTGRES_PASSWORD=change-me-postgres
SBAM_DB_PASSWORD=change-me-sbam
TEMPORAL_DB_PASSWORD=change-me-temporal
KEYCLOAK_DB_PASSWORD=change-me-keycloak
LANGFUSE_DB_PASSWORD=change-me-langfuse

# --- Keycloak (required). Admin console: http://localhost:${KEYCLOAK_PORT} (user "admin"). ---
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
# Password of the local seed users (super-admin, admin-a, fde-a1, fde-a2, admin-b, fde-b1, fde-ab),
# created by the keycloak-seed job. Local/dev only.
SEED_USER_PASSWORD=change-me-seed
# Secret of sbam-api's Keycloak service account (sbam-api-admin), which creates tenant organizations
# (#49). keycloak-seed creates the client locally. Empty: POST /admin/tenants answers 503.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-kc-api-admin

# --- tusd -> sbam-api hooks (required; hooks are wired by #61). ---
TUSD_HOOK_SECRET=change-me-tusd
# Signs the upload tokens the API hands to browsers (A-14); a different value from TUSD_HOOK_SECRET so
# rotating or leaking one never touches the other. Empty = dev uses TUSD_HOOK_SECRET; staging and
# production require their own (openssl rand -hex 32).
UPLOAD_TOKEN_KEY=change-me-upload-token

# Run more than one sbam-api replica? Set SBAM_API_REPLICAS to the count and CURSOR_SECRET to one shared
# value (openssl rand -hex 32): list cursors are signed with it. The API refuses to start otherwise.
# Above one replica the per-user request budgets are also counted in PostgreSQL (rate_windows), so the
# configured number is the cluster's, not each replica's.
# Left as is, each process signs with its own random key (fine for one replica).
SBAM_API_REPLICAS=1
CURSOR_SECRET=

# --- sbam-mock-api (E13.5). Bearer token for its control surface (install a run's stubs, read the journal);
# 16+ characters. Tools under test never receive it. Deployed environments use the mock_control_token secret.
MOCK_CONTROL_TOKEN=change-me-mock-control

# --- sandbox-local profile (E13.2): the local-docker sandbox is the skill-runtime image plus an agent. The worker
# calls the agent with this bearer token (16+ characters, never reaches tools under test). Required only with
# `make up PROFILES=sandbox-local`. SANDBOX_RUNTIME_DIGEST is what the runner reports as its runtime (sha256:<hex>).
SANDBOX_AGENT_TOKEN=change-me-sandbox-agent
SANDBOX_RUNTIME_DIGEST=

# tusd answers cross-origin requests only from this origin (a regular expression, anchored). The default
# is the local web app (`\z` ends the pattern); behind the proxy the portal and /files/ share an origin and no CORS is needed.
# TUSD_CORS_ORIGIN=^http://localhost:3000\z

# --- Storage (#37). HMAC key for signed download URLs; long and random (openssl rand -hex 32). ---
STORAGE_SIGNING_KEY=change-me-storage

  # --- LLM (optional). The OpenRouter key goes to bifrost only; empty keeps the mock provider. ---
OPENROUTER_API_KEY=
LLM_PROVIDER=mock
# Cost control (#420, ADR 0015). Identical LLM input is answered from the tenant's cache instead of being billed
# again (false turns that off). The budgets are opt-in: empty = no limit; a number in USD refuses the next model
# call, non-retryably, once the project's (or tenant's) recorded spend reaches it. NaN, Infinity, 0 and negative
# values stop the workers at start. The check runs before a call, so parallel calls can overshoot by what is in flight.
LLM_DERIVATIVE_CACHE=true
LLM_PROJECT_BUDGET_USD=
LLM_TENANT_BUDGET_USD=
# What a call costs when Bifrost reports no cost (a model its catalogue cannot price), and what Cognee's calls cost
# (sbam-knowledge, sbam-embed): JSON, USD per million tokens, per alias. Read only while a budget is set. With a
# budget and no cost source an alias is refused from its second call, not counted as free; a free model: {"in":0,"out":0}.
# LLM_PRICE_USD_PER_MTOK='{"sbam-knowledge": {"in": 0.15, "out": 0.6}, "sbam-embed": {"in": 0.02, "out": 0}}'
LLM_PRICE_USD_PER_MTOK=
# Cognee in worker-knowledge (#78). HMAC key that derives each project's Cognee user password; at least
# 32 characters, long and random (openssl rand -hex 32). Changing it locks the existing project users out.
COGNEE_USER_SECRET=change-me-cognee-user-secret-0000000000
# Bifrost aliases Cognee uses for graph extraction and embeddings, and the key it sends to Bifrost. The openai/
# prefix tells LiteLLM (inside Cognee) the endpoint is OpenAI-compatible; Bifrost receives the bare alias.
COGNEE_LLM_MODEL=openai/sbam-knowledge
COGNEE_EMBEDDING_MODEL=openai/sbam-embed
COGNEE_EMBEDDING_DIMENSIONS=1536
COGNEE_BIFROST_KEY=sbam-local

# --- sbam-web (optional). 1 = dev role picker on /login-admin and /login-fde (ignored in prod builds). ---
SBAM_DEV_AUTH=1
# Encrypts the Auth.js session cookie (#51). Set it to turn on "Sign in with Keycloak"; empty keeps it off.
# Long and random: openssl rand -hex 32.
AUTH_SECRET=change-me-auth

# --- sbam-api (optional). ---
MAX_BODY_BYTES=10485760
# Per-user request budgets, per minute and per API process (0 = off): every write, and the routes that start
# LLM work (regenerate, rebuild, retry, pipeline start). Over budget = 429 with Retry-After.
RATE_LIMIT_WRITES_PER_MINUTE=120
RATE_LIMIT_LLM_PER_MINUTE=10
# access_denied audit rows written per user per minute; more denials are only logged.
AUDIT_DENIED_PER_MINUTE=30
LOG_LEVEL=INFO
# Sample long-running command POST /api/v1/projects/{id}/runs/ping (#40). Local stacks only; false elsewhere.
ENABLE_PING=true

# --- Profiles (optional): `make up PROFILES=obs,analytics,sandbox-local`. Only needed for those profiles. ---
# obs: Grafana LGTM (OTel collector + Tempo/Loki/Prometheus) and Langfuse. Grafana user "admin".
GRAFANA_PORT=3002
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
LANGFUSE_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Operator alert channel (E16.1): a webhook URL (Slack/Teams/etc. incoming webhook) per environment. It is a
# secret in staging/production: set it in that environment's .env only. This default discards alerts.
GRAFANA_ALERT_WEBHOOK_URL=http://127.0.0.1:9/sbam-operator-alerts
LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse-nextauth
LANGFUSE_SALT=change-me-langfuse-salt
# Exactly 64 hex characters: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=change-me-run-openssl-rand-hex-32
# Langfuse-only stores (internal network, no host ports)
CLICKHOUSE_PASSWORD=change-me-clickhouse
LANGFUSE_REDIS_PASSWORD=change-me-redis
LANGFUSE_MINIO_PASSWORD=change-me-minio
# LLM traces from the workers (E16.2): a key pair of the environment's Langfuse project (sbam-dev on a
# laptop; create it in the Langfuse UI). Empty = no traces (the default). LANGFUSE_LOG_CONTENT=true sends
# prompt and answer text instead of sizes and hashes: development only, refused in production. On VMs
# the host is set by compose.deploy.obs.yaml and the keys are Docker secrets.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_LOG_CONTENT=false
# analytics: PostHog (stub until #142)
POSTHOG_PORT=8010
# Product events (E16.2), sent by the workers from the outbox. Empty = off (the default on laptops).
# On a VM: the environment's PostHog project (its phc_ ingestion key) and a salt for hashing user ids
# (openssl rand -hex 32; required outside development once PostHog is on).
POSTHOG_HOST=
POSTHOG_API_KEY=
POSTHOG_DISTINCT_ID_SALT=

# --- Deployed environments (E16.3, #142). Ignored on laptops; used by compose.deploy.yaml on dev/staging/prod VMs. ---
# The VM's env file lives at /etc/sbam/<env>.env (root, mode 0640) and holds only these settings plus inert
# placeholders for the secret variables above. The real secrets are files in SBAM_SECRETS_DIR (docs/runbooks/environments.md).
# Image digests come from a release file after it: see compose/release.env.example.
# The environment the workers report (and check their settings against): staging or production on those
# VMs. sbam-api gets it from compose.<env>.yaml.
# SBAM_ENV=staging
# Public hostnames of the portals and of the Keycloak login (DNS must point at the proxy).
SBAM_PORTAL_HOST=portal.example.invalid
SBAM_AUTH_HOST=auth.example.invalid
# The VM's Netbird address: Temporal UI, Keycloak (admin console), Grafana, Langfuse and PostHog bind here only.
SBAM_OPS_BIND=127.0.0.1
# Proxy bind address for dev/staging (their Netbird address). Prod hard-codes 0.0.0.0 in compose.prod.yaml.
SBAM_PROXY_BIND=127.0.0.1
# TLS: empty = ACME (Let's Encrypt, auto-renewal); "internal" = Caddy's own CA (dev only);
# "/certs/fullchain.pem /certs/privkey.pem" = certificates you provide (files in SBAM_TLS_CERT_DIR, root, 0400).
SBAM_TLS=
SBAM_ACME_EMAIL=ops@example.invalid
SBAM_TLS_CERT_DIR=/etc/sbam/tls
# Per-client-IP limits at the proxy, per minute (A-08b): every portal path, sign-in (/api/auth, /login-*), files
# and uploads, and the Keycloak host. Over the limit = 429 with Retry-After, before the app sees the request.
SBAM_RATE_PORTAL_EVENTS=600
SBAM_RATE_SIGNIN_EVENTS=30
SBAM_RATE_FILES_EVENTS=300
SBAM_RATE_AUTH_HOST_EVENTS=300
# Directory of the Docker secret files (one file per secret, root, mode 0400): scripts/check-secrets.sh.
SBAM_SECRETS_DIR=/etc/sbam/secrets
# Keycloak realm rendered for the public origin: python compose/keycloak/render_realm.py --origin https://$SBAM_PORTAL_HOST
SBAM_REALM_FILE=/etc/sbam/realm-bullm.json
# Optional: where the Keycloak admin console links point (default http://$SBAM_OPS_BIND:$KEYCLOAK_PORT).
# SBAM_KC_ADMIN_URL=
